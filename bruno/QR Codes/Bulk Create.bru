meta {
  name: Bulk Create
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/qr-codes/bulk-create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "count": 10,
    "purpose": "digital"
  }
}

docs {
  Bulk creates multiple unassigned QR codes as a tracked batch.
  Allowed counts: 10, 25, 50, 100, 200, 500, 1000
}
