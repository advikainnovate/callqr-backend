meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "testuser_44",
    "password": "password123",
    "phone": "+1234567890",
    "emergencyContact": "+1234567891",
    "email": "kklr2684@gmail.com"
  }
}

docs {
  Register a new user account.
  
  Required fields:
  - username: 3-50 characters
  - password: minimum 6 characters
  - email: email address
  - emergencyContact: emergency contact phone number
  
  Optional fields:
  - phone: user's phone number
  
  Returns:
  - JWT token for API authentication
  - User profile (id, username, status, createdAt)
  - verification: { required: true, type: 'email' }
  
  Use the token in Authorization header: Bearer <token>
  Note: the token only works on verification-related endpoints until the email is verified.
}
