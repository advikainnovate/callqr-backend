meta {
  name: Verify Email
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/verify-email
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "otp": "564105"
  }
}

docs {
  Verify email using OTP.
  Requires authentication.
  Returns success message and activates account if pending_verification.
}
