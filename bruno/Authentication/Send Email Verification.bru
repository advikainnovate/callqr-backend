meta {
  name: Send Email Verification
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/send-email-verification
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "email": "testuser@example.com"
  }
}

docs {
  Send OTP to email address for verification.
  Requires authentication.
  OTP expires in 10 minutes.
}
