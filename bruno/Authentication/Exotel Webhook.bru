meta {
  name: Exotel Webhook (Missed Call)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/auth/exotel-webhook
  body: formUrlEncoded
  auth: none
}

headers {
  X-Exotel-Webhook-Token: {{exotelWebhookToken}}
}

body:form-urlencoded {
  From: +919876543210
  CallStatus: no-answer
}

docs {
  Simulates the Exotel Webhook for Missed Call Verification.
  It does not use JWT auth, but it now requires the shared X-Exotel-Webhook-Token header.
  Exotel sends data as application/x-www-form-urlencoded.
}
