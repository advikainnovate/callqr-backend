meta {
  name: Block User
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/admin/users/:userId/block
  body: json
  auth: bearer
}

body:json {
  {
    "reason": "Repeated harassment reported by multiple users"
  }
}

params:path {
  userId: user-id-here
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Legacy compatibility alias for the global block endpoint.
  Reason is required and will be shown to the user on login.
}
