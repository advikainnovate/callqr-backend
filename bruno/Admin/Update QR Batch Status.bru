meta {
  name: Update QR Batch Status
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/admin/qr-batches/:batchId/status
  body: json
  auth: bearer
}

params:path {
  batchId: fe6e18b2-2c46-4090-8a2e-343ce1947776
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "status": "printed",
    "notes": "Sent to print vendor",
    "printJobRef": "PRINT-001"
  }
}

docs {
  Update a printing batch workflow status.
  
  Allowed transitions:
  - generated -> print_pending
  - print_pending -> printed
  - printed -> distributed
  
  Digital batches are not manually updated through this endpoint.
}
