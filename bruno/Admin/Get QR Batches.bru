meta {
  name: Get QR Batches
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/admin/qr-batches?status=generated&page=1&limit=50&sort=newest
  body: none
  auth: bearer
}

params:query {
  status: generated
  page: 1
  limit: 50
  sort: newest
  ~purpose: printing
  ~offset: 0
  ~sortBy: updatedAt
  ~sortOrder: asc
  ~search: PR-250526-
}

auth:bearer {
  token: {{authToken}}
}

docs {
  List QR batches with optional filters:
  - purpose: printing, digital
  - status: batch workflow status
  - search: batch number
  - page, limit, offset: pagination
  - sort: newest, oldest
  - sortBy: createdAt, updatedAt
  - sortOrder: asc, desc
}
