meta {
  name: Bulk Create QR Codes
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/admin/qr-codes/bulk-create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "count": 10,
    "purpose": "printing",
    "notes": "Launch print batch",
    "printJobRef": "PRINT-001"
  }
}

docs {
  Bulk create QR codes as a tracked batch.
  Allowed counts: 10, 25, 50, 100, 200, 500, 1000
  Purposes:
  - printing
  - digital
  
  Response includes:
  - created batch metadata with batchNumber
  - batch workflow metadata
  - generated QR codes with shared batchId
}
