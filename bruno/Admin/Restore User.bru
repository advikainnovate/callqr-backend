meta {
  name: Restore User
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/admin/users/:userId/restore
  body: none
  auth: bearer
}

params:path {
  userId: user-id-here
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Restore a soft-deleted user (sets status back to 'active').
  Reinstates login access and all associated data (QR codes, history, subscription).
}
